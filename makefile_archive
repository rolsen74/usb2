
#
ROOTDIR				:= $(realpath .)
BINDIR				:= $(ROOTDIR)/_Data

###########################################################################

all: build_all

.PHONY: all build_all build_dir_tree build_stack build_printer build_video build_sdr_test build_bluetooth_test \
	build_ptp build_serial build_smartcard build_audio build_rtl8152 build_rtl8188 build_sis163u build_rt2870 build_rtl8821cu build_analyzer \
	build_rtl8811au build_wifi build_wpa build_wpa2 build_wpa3 build_wireless_manager build_archive

###########################################################################

build_all: build_archive
	@echo "Done"

###########################################################################

build_dir_tree:
	rm -rf $(BINDIR)
	mkdir -p $(BINDIR)/usb2/Devs
	mkdir -p $(BINDIR)/usb2/Devs/AHI
	mkdir -p $(BINDIR)/usb2/Devs/AudioModes
	mkdir -p $(BINDIR)/usb2/Devs/Firmware
	mkdir -p $(BINDIR)/usb2/Devs/Networks
	mkdir -p $(BINDIR)/usb2/Libs/USB2
	mkdir -p $(BINDIR)/usb2/Kickstart
	mkdir -p $(BINDIR)/usb2/Tools
	# File pickers need a file for devices registered by usb2.kmod.
	printf '\n' > "$(BINDIR)/usb2/Devs/usb2audio.device"
	printf '\n' > "$(BINDIR)/usb2/Devs/usb2video.device"
	printf '\n' > "$(BINDIR)/usb2/Devs/usb2parallel.device"
	printf '\n' > "$(BINDIR)/usb2/Devs/usb2serial.device"
	printf '\n' > "$(BINDIR)/usb2/Devs/usb2printer.device"
	printf '\n' > "$(BINDIR)/usb2/Devs/Networks/usb2ethernet.device"

###########################################################################

build_stack: | build_dir_tree
	@echo "Building Stack"
	cd $(ROOTDIR) && \
	$(MAKE) -f makefile clean && \
	$(MAKE) -f makefile && \
	$(MAKE) -f makefile strip && \
	cp bin/usb2.kmod $(BINDIR)/usb2/Kickstart
	@echo "Stack done"

###########################################################################

build_printer: | build_dir_tree
	@echo "Building Printer Driver"
	cd $(ROOTDIR)/Drivers/Printer && \
	$(MAKE) -f makefile USBTYPE=USB2 clean && \
	$(MAKE) -f makefile USBTYPE=USB2 && \
	$(MAKE) -f makefile USBTYPE=USB2 strip && \
	cp bin/cls_Printer.Driver cls_Printer.Class $(BINDIR)/usb2/Libs/USB2
	@echo "Printer done"

###########################################################################

build_video: | build_dir_tree
	@echo "Building Video Driver"
	cd $(ROOTDIR)/Drivers/Video && \
	$(MAKE) -f makefile clean && \
	$(MAKE) -f makefile && \
	cp bin/cls_Video.Driver cls_Video.Class $(BINDIR)/usb2/Libs/USB2
	cd $(ROOTDIR)/Drivers/Video/Test && \
	$(MAKE) -f makefile clean && \
	$(MAKE) -f makefile && \
	cp USB2VideoTest $(BINDIR)/usb2/Tools
	@echo "Video done"

###########################################################################

build_sdr_test: | build_dir_tree
	@echo "Building USB2SDRTest"
	$(MAKE) -C Programs/USB2SDRTest clean
	$(MAKE) -C Programs/USB2SDRTest
	cp Programs/USB2SDRTest/bin/USB2SDRTest $(BINDIR)/usb2/Tools

###########################################################################

build_bluetooth_test: | build_dir_tree
	@echo "Building Bluetooth USB class driver"
	$(MAKE) -C Drivers/Bluetooth/USBHCI BINDIR=bin
	cp Drivers/Bluetooth/USBHCI/bin/cls_Bluetooth.Driver Drivers/Bluetooth/USBHCI/cls_Bluetooth.Class $(BINDIR)/usb2/Libs/USB2
	@echo "Building USB2BluetoothTest"
	$(MAKE) -C Programs/USB2BluetoothTest
	cp Programs/USB2BluetoothTest/bin/USB2BluetoothTest $(BINDIR)/usb2/Tools

