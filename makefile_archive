###########################################################################

build_archive: build_stack build_printer build_video build_sdr_test build_bluetooth_test build_ptp build_serial build_smartcard build_audio \
	build_rtl8152 build_rtl8188 build_sis163u build_rt2870 build_rtl8821cu build_rtl8811au build_analyzer build_wifi build_wpa build_wpa2 build_wpa3 build_wireless_manager
