###########################################################################

build_smartcard: | build_dir_tree
	@echo "Building USB CCID smart-card driver and test"
	$(MAKE) -C Drivers/SmartCard
	$(MAKE) -C Programs/USB2SmartCardTest
	cp Drivers/SmartCard/bin/cls_SmartCard.Driver Drivers/SmartCard/cls_SmartCard.Class $(BINDIR)/usb2/Libs/USB2
	cp Programs/USB2SmartCardTest/bin/USB2SmartCardTest $(BINDIR)/usb2/Tools

###########################################################################

build_audio: | build_dir_tree
	@echo "Building Audio Driver"
	cd $(ROOTDIR)/Drivers/Audio && \
	$(MAKE) -f makefile BINDIR=bin clean && \
	$(MAKE) -f makefile BINDIR=bin && \
	$(MAKE) -C AHI BINDIR=bin clean && \
	$(MAKE) -C AHI BINDIR=bin && \
	cp bin/cls_Audio.Driver cls_Audio.Class $(BINDIR)/usb2/Libs/USB2 && \
	cp AHI/bin/usb2.audio AHI/bin/bluetooth2.audio $(BINDIR)/usb2/Devs/AHI && \
	cp AHI/bin/USB2 AHI/bin/Bluetooth2 $(BINDIR)/usb2/Devs/AudioModes
	cd $(ROOTDIR)/Drivers/Audio/Test && \
	$(MAKE) -f makefile clean && \
	$(MAKE) -f makefile && \
	cp USB2AudioTest $(BINDIR)/usb2/Tools
	@echo "Audio done"

