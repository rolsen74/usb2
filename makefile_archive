
#
ROOTDIR				:= $(realpath .)
BINDIR				:= $(ROOTDIR)/_Data

###########################################################################

all: build_all

.PHONY: all build_all build_dir_tree build_stack build_printer build_video \
	build_ptp build_serial build_audio build_rtl8152 build_rtl8188 build_analyzer \
	build_wpa2 build_wireless_manager build_archive

###########################################################################

build_all: build_archive
	@echo "Done"

###########################################################################

build_dir_tree:
	rm -rf $(BINDIR)
	mkdir -p $(BINDIR)/usb2/Devs
	mkdir -p $(BINDIR)/usb2/Devs/AHI
	mkdir -p $(BINDIR)/usb2/Devs/AudioModes
	mkdir -p $(BINDIR)/usb2/Devs/Firmware
	mkdir -p $(BINDIR)/usb2/Devs/Networks
	mkdir -p $(BINDIR)/usb2/Libs/USB2
	mkdir -p $(BINDIR)/usb2/Kickstart
	mkdir -p $(BINDIR)/usb2/Tools

###########################################################################

build_stack: | build_dir_tree
	@echo "Building Stack"
	cd $(ROOTDIR) && \
	$(MAKE) -f makefile clean && \
	$(MAKE) -f makefile && \
	$(MAKE) -f makefile strip && \
	cp bin/usb2.device $(BINDIR)/usb2/Kickstart
	@echo "Stack done"

###########################################################################

build_printer: | build_dir_tree
	@echo "Building Printer Driver"
	cd $(ROOTDIR)/Drivers/Printer && \
	$(MAKE) -f makefile USBTYPE=USB2 clean && \
	$(MAKE) -f makefile USBTYPE=USB2 && \
	$(MAKE) -f makefile USBTYPE=USB2 strip && \
	cp bin/usb2printer.device $(BINDIR)/usb2/Devs
	@echo "Printer done"

###########################################################################

build_video: | build_dir_tree
	@echo "Building Video Driver"
	cd $(ROOTDIR)/Drivers/Video && \
	$(MAKE) -f makefile clean && \
	$(MAKE) -f makefile && \
	cp bin/Video.Driver Video.Class $(BINDIR)/usb2/Libs/USB2
	cd $(ROOTDIR)/Drivers/Video/Test && \
	$(MAKE) -f makefile clean && \
	$(MAKE) -f makefile && \
	cp USB2VideoTest $(BINDIR)/usb2/Tools
	@echo "Video done"

###########################################################################

build_ptp: | build_dir_tree
	@echo "Building PTP Driver"
	cd $(ROOTDIR)/Drivers/PTP && \
	$(MAKE) -f makefile clean && \
	$(MAKE) -f makefile && \
	$(MAKE) -f makefile strip && \
	cp bin/PTP.Driver PTP.Class $(BINDIR)/usb2/Libs/USB2
	@echo "PTP done"

###########################################################################

build_serial: | build_dir_tree
	@echo "Building PL2303 Serial Driver"
	cd $(ROOTDIR)/Drivers/Serial/PL2303 && \
	$(MAKE) -f makefile clean && \
	$(MAKE) -f makefile && \
	cp bin/PL2303.Driver PL2303.Class $(BINDIR)/usb2/Libs/USB2
	@echo "PL2303 Serial done"

###########################################################################

build_audio: | build_dir_tree
	@echo "Building Audio Driver"
	cd $(ROOTDIR)/Drivers/Audio && \
	$(MAKE) -f makefile clean && \
	$(MAKE) -f makefile && \
	$(MAKE) -C AHI clean && \
	$(MAKE) -C AHI && \
	cp bin/Audio.Driver Audio.Class $(BINDIR)/usb2/Libs/USB2 && \
	cp AHI/bin/usb2.audio $(BINDIR)/usb2/Devs/AHI && \
	cp AHI/bin/USB2 $(BINDIR)/usb2/Devs/AudioModes
	@echo "Audio done"

###########################################################################

build_rtl8152: | build_dir_tree
	@echo "Building RTL8152 Ethernet Driver"
	cd $(ROOTDIR)/Drivers/Ethernet/RTL8152 && \
	$(MAKE) -f makefile clean && \
	$(MAKE) -f makefile && \
	$(MAKE) -f makefile strip && \
	cp bin/usb2rtl8152.device $(BINDIR)/usb2/Devs/Networks
	@echo "RTL8152 Ethernet done"

###########################################################################

build_rtl8188: | build_dir_tree
	@echo "Building RTL8188EU Wi-Fi Driver"
	cd $(ROOTDIR)/Drivers/Ethernet/RTL8188 && \
	$(MAKE) -f makefile clean && \
	$(MAKE) -f makefile && \
	$(MAKE) -f makefile strip && \
	cp bin/usb2rtl8188.device $(BINDIR)/usb2/Devs/Networks && \
	cp Firmware/rtl8188eufw.bin Firmware/rtl8188eufw.licence $(BINDIR)/usb2/Devs/Firmware
	@echo "RTL8188EU Wi-Fi done"

###########################################################################

build_analyzer: | build_dir_tree
	@echo "Building USB2Analyzer"
	cd $(ROOTDIR)/Programs/USB2Analyzer && \
	$(MAKE) -f makefile clean && \
	$(MAKE) -f makefile && \
	$(MAKE) -f makefile strip && \
	cp bin/USB2Analyzer $(BINDIR)/usb2/Tools
	@echo "USB2Analyzer done"

###########################################################################

build_wpa2: | build_dir_tree
	@echo "Building WPA2 Library"
	cd $(ROOTDIR)/Libraries/WPA2 && \
	$(MAKE) -f makefile clean && \
	$(MAKE) -f makefile && \
	$(MAKE) -f makefile strip && \
	cp bin/usb2wpa2.library $(BINDIR)/usb2/Libs
	@echo "WPA2 Library done"

###########################################################################

build_wireless_manager: | build_dir_tree
	@echo "Building USB2WirelessManager"
	cd $(ROOTDIR)/Programs/USB2WirelessManager && \
	$(MAKE) -f makefile clean && \
	$(MAKE) -f makefile && \
	$(MAKE) -f makefile strip && \
	cp bin/USB2WirelessManager $(BINDIR)/usb2/Tools
	@echo "USB2WirelessManager done"

###########################################################################

build_archive: build_stack build_printer build_video build_ptp build_serial build_audio \
	build_rtl8152 build_rtl8188 build_analyzer build_wpa2 build_wireless_manager
	@echo "Building Archive"
	@rm -f usb2.lha
	cd "$(BINDIR)" && lha a "$(ROOTDIR)/usb2.lha" usb2
	@echo "Building done"

###########################################################################
